# Absolutní četnosti genotypů
D <- 60   # AA
H <- 100  # Aa
R <- 200  # aa
cat("AA =", D, "\n")
cat("Aa =", H, "\n")
cat("aa =", R, "\n")
cat("AA =", D, "Aa =", H, "aa =", R, "\n")
# Absolutní četnosti genotypů
N_AA <- 60
N_Aa <- 100
N_aa <- 200
N <- N_AA + N_Aa + N_aa  # celkový počet jedinců
cat("AA =", D, "Aa =", H, "aa =", R, "N=", N, "\n")
delta_q <- function(q, s) {
-s * q^2 * (1 - q) / (1 - s * q^2)
}
delta_q_obecne <- function(q, W_AA = 1, W_Aa = 1, W_aa = 0.5) {
p     <- 1 - q
w_bar <- p^2 * W_AA + 2 * p * q * W_Aa + q^2 * W_aa   # průměrná fitness
q_nove <- (q^2 * W_aa + p * q * W_Aa) / w_bar          # q v další generaci
q_nove - q
}
s  <- 0.5      # selekční koeficient (W_aa = 1 - s)
q0 <- 0.5      # počáteční frekvence alely a
t  <- 100      # počet generací
q_hodnoty <- c(0.01, 0.1, 0.25, 0.5, 0.73, 0.9, 0.99)
tab <- data.frame(
q       = q_hodnoty,
delta_q = delta_q(q_hodnoty, s)
)
print(tab, digits = 4, row.names = FALSE)
# kontrola: vzorec = obecný výpočet z fitness
stopifnot(all.equal(delta_q(q_hodnoty, s),
delta_q_obecne(q_hodnoty, 1, 1, 1 - s)))
opt <- optimize(function(q) delta_q(q, s), interval = c(0, 1))
cat(sprintf("\nNejvětší pokles: q = %.3f, delta q = %.4f\n",
opt$minimum, opt$objective))
# ------------------------------------------------------------------
# 3) Vývoj q v čase: q(t+1) = q(t) + delta q
# ------------------------------------------------------------------
q_t <- numeric(t + 1)
q_t[1] <- q0
for (i in 1:t) q_t[i + 1] <- q_t[i] + delta_q(q_t[i], s)
cat(sprintf("q po %d generacích: %.4f\n", t, q_t[t + 1]))
# ------------------------------------------------------------------
# 4) Grafy
# ------------------------------------------------------------------
op <- par(mfrow = c(1, 2))
# a) Rychlost změny
curve(delta_q(x, s), from = 0, to = 1, lwd = 2, col = "#e69f00",
xlab = "Frekvence alely q", ylab = "Změna za 1 generaci (delta q)",
main = "Rychlost evoluce")
abline(h = 0, lty = 2)
# b) Trajektorie q v čase
plot(0:t, q_t, type = "l", lwd = 2, col = "#0072b2", ylim = c(0, 1),
xlab = "Generace", ylab = "Frekvence alely a (q)",
main = "Trajektorie q")
par(op)
op <- par(mfrow = c(1, 2))
