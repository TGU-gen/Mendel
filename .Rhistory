library(dplyr)
library(ggplot2)
a <- 10   # aditivní efekt (polovina rozdílu homozygotů)
d_values <- c(0, a/2, a, 1.5*a, -a)
types <- c("Aditivní (d=0)",
"Neúplná dominance (d=a/2)",
"Úplná dominance (d=a)",
"Superdominance (d>a)",
"Recesivita (d=-a)")
gene_df <- expand.grid(
Genotype = c("aa","Aa","AA"),
Type = types
)
gene_df$d <- rep(d_values, each = 3)
gene_df <- gene_df %>%
mutate(
G = case_when(
Genotype == "aa" ~ -a,
Genotype == "Aa" ~ d,
Genotype == "AA" ~ a
)
)
gene_df$Genotype <- factor(gene_df$Genotype,
levels = c("aa","Aa","AA"))
ggplot(gene_df, aes(x=Genotype, y=G,
group=Type, color=Type)) +
geom_line(size=1.2) +
geom_point(size=4) +
geom_hline(yintercept=0, linetype="dashed") +
labs(title="Typy genového působení",
y="Genotypová hodnota (G)") +
theme_minimal() +
theme(legend.position="bottom")
# Aditivní efekt alely:
# alpha = a + d(q - p)
# Aditivní variance:
# VA = 2pq * alpha^2
# Dominantní variance:
# VD = (2pq d)^2
var_df <- expand.grid(p=p, Type=types)
var_df$d <- rep(d_values, each=length(p))
var_df$q <- 1 - var_df$p
var_df <- var_df %>%
mutate(
alpha = a + d*(q - p),
VA = 2*p*q*alpha^2,
VD = (2*p*q*d)^2
)
# Aditivní variance
ggplot(var_df, aes(x=p, y=VA, color=Type)) +
geom_line(size=1.2) +
labs(title="Aditivní genetická variance (VA)",
x="p",
y="VA") +
theme_minimal()
# Dominantní variance
ggplot(var_df, aes(x=p, y=VD, color=Type)) +
geom_line(size=1.2) +
labs(title="Dominantní genetická variance (VD)",
x="p",
y="VD") +
theme_minimal()
############################################################
# 6) HERITABILITA (volitelné rozšíření)
############################################################
VE <- 20  # environmentální variance (nastavitelná)
var_df <- var_df %>%
mutate(
VP = VA + VD + VE,
h2 = VA / VP
)
ggplot(var_df, aes(x=p, y=h2, color=Type)) +
geom_line(size=1.2) +
labs(title="Úzkosmyslová heritabilita (h²)",
x="p",
y="h²") +
theme_minimal()
ggplot(var_df, aes(x=p, y=h2, color=Type)) +
geom_line(size=1.2) +
labs(title="Heritabilita v úzkém smyslu (h²)",
x="p",
y="h²") +
theme_minimal()
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
