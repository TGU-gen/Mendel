generuj_cislo <- function(n = 1, od = 1, do_ = 20, opakovani = TRUE) {
sample(od:do_, size = n, replace = opakovani)
}
vysledek <- generuj_cislo(n = 2)
cat("2 náhodných čísel (funkce):", vysledek, "\n")
