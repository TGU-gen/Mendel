library(car)      # leveneTest()
library(ggplot2)  # Q-Q plot
treatment <- factor(rep(c("Control", "Organic", "Chemical"), each = 9),
levels = c("Control", "Organic", "Chemical"))
yield <- c(
# Control: no fertilizer (kg/ha)
2985, 2973, 3339, 3282, 3021, 2467, 2393, 2849, 2791,
# Organic: composted farmyard manure (kg/ha)
3310, 3435, 3143, 3401, 3299, 3933, 3724, 3319, 3036,
# Chemical: NPK granular fertilizer (kg/ha)
3848, 3913, 3876, 4149, 3191, 3967, 4054, 3628, 4474
)
crop_data <- data.frame(treatment, yield)
# Fit model first so residuals are available
model <- aov(yield ~ treatment, data = crop_data)
summary(model)
# Shapiro-Wilk on residuals
shapiro.test(residuals(model))
qqnorm(residuals(model), main = "Normal Q-Q Plot of Residuals")
qqline(residuals(model), col = "red", lwd = 2)
leveneTest(yield ~ treatment, data = crop_data, center = median)
model <- aov(yield ~ treatment, data = crop_data)
summary(model)
ss   <- summary(model)[[1]][, "Sum Sq"]
eta2 <- ss[1] / sum(ss)       # SS_treatment / SS_total
cat("eta-squared =", round(eta2, 3), "\n")
ggplot(crop_data, aes(x = treatment, y = yield, fill = treatment)) +
geom_boxplot(alpha = 0.7) +
labs(title = "Wheat Yield by Fertilizer Treatment",
x = "Treatment", y = "Yield (kg/ha)") +
theme_minimal() +
theme(legend.position = "none")
tukey_result <- TukeyHSD(model, conf.level = 0.95)
print(tukey_result)
plot(tukey_result, las = 1, col = "steelblue")
source("apa_format.R")
cat(apa_report(model), "\n\n")
cat(apa_t_test(t.test(rnorm(20), rnorm(20))), "\n")
cat(apa_cor_test(cor.test(rnorm(20), rnorm(20))), "\n")
