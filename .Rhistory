library(ggplot2)
library(ggrepel)
library(factoextra)
library(dplyr)
df <- data.frame(
Plant       = 1:4,
Height      = c(35, 40, 38, 45),
LeafArea    = c(120, 135, 128, 150),
Chlorophyll = c(42, 46, 44, 49),
RootLength  = c(15, 18, 17, 21)
)
X <- df[ , -1]   # odstraní sloupec "Plant"
X_scaled <- scale(X)   # průměr = 0, SD = 1 (jako StandardScaler v Pythonu)
X_scaled
pca_result <- prcomp(X_scaled, center = FALSE, scale. = FALSE)
pca_result
# Přehled výsledků
summary(pca_result)
explained_var  <- pca_result$sdev^2 / sum(pca_result$sdev^2)
cumulative_var <- cumsum(explained_var)
cat("Vysvětlený rozptyl (podíl):\n")
print(round(explained_var, 4))
cat("\nKumulativní vysvětlený rozptyl:\n")
print(round(cumulative_var, 4))
scores <- as.data.frame(pca_result$x)
scores$Sample <- 1:nrow(scores)   # nebo rownames(df)
cat("\nPC skóre (prvních 6 řádků):\n")
print(head(scores))
scree_df <- data.frame(
PC       = paste0("PC", 1:length(explained_var)),
Variance = explained_var * 100
)
scree_df$PC <- factor(scree_df$PC, levels = scree_df$PC)
ggplot(scree_df, aes(x = PC, y = Variance, group = 1)) +
geom_line(color = "#2c7bb6", linewidth = 0.8) +
geom_point(size = 3, color = "#2c7bb6") +
labs(
title    = "Scree Plot",
x        = "Hlavní komponenta",
y        = "Vysvětlený rozptyl (%)"
) +
theme_bw(base_size = 13) +
theme(plot.title = element_text(hjust = 0.5))
ggplot(scores, aes(x = PC1, y = PC2, label = Sample)) +
geom_point(size = 3, color = "#4dac26") +
geom_text_repel(size = 4, box.padding = 0.4) +
labs(
title = "PCA – Score Plot (PC1 vs PC2)",
x     = paste0("PC1 (", round(explained_var[1] * 100, 1), "%)"),
y     = paste0("PC2 (", round(explained_var[2] * 100, 1), "%)")
) +
theme_bw(base_size = 13) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray60") +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray60") +
theme(plot.title = element_text(hjust = 0.5))
df_treat <- data.frame(
Treatment   = c("Kontrola", "Kontrola", "Hnojivo", "Hnojivo",
"Zálivka",  "Zálivka",  "Kombinace","Kombinace"),
Height      = c(30, 32, 42, 44, 38, 40, 50, 52),
LeafArea    = c(100,105, 145,150, 130,135, 160,165),
Chlorophyll = c(38, 39,  50, 51,  45, 46,  55, 56),
RootLength  = c(12, 13,  20, 21,  17, 18,  24, 25)
)
labels_treat <- df_treat$Treatment
X_treat      <- df_treat[ , -1]
X_treat_sc   <- scale(X_treat)
pca_treat    <- prcomp(X_treat_sc, center = FALSE, scale. = FALSE)
ev_treat     <- pca_treat$sdev^2 / sum(pca_treat$sdev^2)
scores_treat <- as.data.frame(pca_treat$x)
scores_treat$Treatment <- labels_treat
ggplot(scores_treat, aes(x = PC1, y = PC2,
color = Treatment, shape = Treatment)) +
geom_point(size = 4) +
stat_ellipse(aes(group = Treatment), type = "t", level = 0.68,
linetype = "dashed", linewidth = 0.7) +
labs(
title = "PCA – Score Plot podle skupin",
x     = paste0("PC1 (", round(ev_treat[1] * 100, 1), "%)"),
y     = paste0("PC2 (", round(ev_treat[2] * 100, 1), "%)")
) +
theme_bw(base_size = 13) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray60") +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray60") +
theme(plot.title  = element_text(hjust = 0.5),
legend.title = element_blank())
